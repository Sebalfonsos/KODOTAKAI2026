# Copia a .env y completa. Nunca subas .env al repositorio.
POSTGRES_DB=translogix
POSTGRES_USER=translogix
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://translogix:<password>@127.0.0.1:5433/translogix
TEST_DATABASE_URL=postgresql+asyncpg://translogix:<password>@127.0.0.1:5433/translogix_test

# LLM local (HAProxy del clúster). La key se lee del archivo; no se copia aquí.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY_FILE=/home/<usuario>/llm-cluster/config/api-key
# Embeddings locales (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# Seguridad
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_ENABLED=true

# Usuarios de demostración que crea `make seed` (contraseñas ≥ 12 caracteres)
DEMO_ADMIN_EMAIL=admin@translogix.demo
DEMO_ADMIN_PASSWORD=
DEMO_ASESOR_EMAIL=asesor@translogix.demo
DEMO_ASESOR_PASSWORD=
DEMO_CLIENTE_EMAIL=cliente@translogix.demo
DEMO_CLIENTE_PASSWORD=
DEMO_VIP_EMAIL=compras@pharmasur.demo
DEMO_VIP_PASSWORD=
